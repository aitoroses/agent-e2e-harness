{
  "name": "@agent-e2e/harness",
  "version": "0.0.0",
  "type": "module",
  "description": "Library-first Agent E2E Harness for seeded journeys, MCP proof loops, artifacts, and cleanup.",
  "keywords": [
    "agent",
    "e2e",
    "mcp",
    "playwright",
    "testing",
    "automation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aitoroses/agent-e2e-harness.git",
    "directory": "packages/harness"
  },
  "bugs": {
    "url": "https://github.com/aitoroses/agent-e2e-harness/issues"
  },
  "homepage": "https://github.com/aitoroses/agent-e2e-harness/tree/main/packages/harness#readme",
  "license": "MIT",
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=22.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "default": "./dist/mcp/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "default": "./dist/cli/index.js"
    },
    "./stack": {
      "types": "./dist/stack/index.d.ts",
      "default": "./dist/stack/index.js"
    },
    "./dev-mcp": {
      "types": "./dist/dev-mcp/index.d.ts",
      "default": "./dist/dev-mcp/index.js"
    },
    "./playwright-mcp": {
      "types": "./dist/playwright-mcp/index.d.ts",
      "default": "./dist/playwright-mcp/index.js"
    },
    "./artifacts": {
      "types": "./dist/artifacts/index.d.ts",
      "default": "./dist/artifacts/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json && chmod +x dist/cli/index.js",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && vitest run"
  },
  "peerDependencies": {
    "playwright": "^1.59.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.2.1"
  },
  "bin": {
    "agent-e2e-harness": "./dist/cli/index.js"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    },
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
